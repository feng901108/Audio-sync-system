<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ===================== JOIN 阶段 ===================== -->
    <ScrollView
        android:id="@+id/join_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal">

            <!-- 品牌行 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="32dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_album"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.05"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- 标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加入广播"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/join_sub"
                android:textSize="15sp"
                android:textColor="@color/muted"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="40dp" />

            <!-- 服务端地址 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_label"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edit_server"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_secondary"
                android:paddingHorizontal="16dp"
                android:hint="@string/server_hint"
                android:textColor="@color/text"
                android:textColorHint="@color/muted_soft"
                android:textSize="15sp"
                android:singleLine="true"
                android:inputType="textUri"
                android:importantForAutofill="no"
                tools:ignore="LabelFor" />

            <!-- 设备名 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_name_label"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edit_device"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_secondary"
                android:paddingHorizontal="16dp"
                android:hint="My Phone"
                android:textColor="@color/text"
                android:textColorHint="@color/muted_soft"
                android:textSize="15sp"
                android:singleLine="true"
                android:inputType="text"
                android:importantForAutofill="no"
                tools:ignore="LabelFor" />

            <Button
                android:id="@+id/btn_join"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_primary"
                android:text="@string/join_btn"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

            <!-- 错误提示 -->
            <TextView
                android:id="@+id/text_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/err"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <!-- 服务端可达性提示 -->
            <TextView
                android:id="@+id/text_servers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="20dp" />
        </LinearLayout>
    </ScrollView>

    <!-- ===================== PLAYER 阶段 ===================== -->
    <LinearLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        android:background="@color/bg">

        <!-- 顶部条: 标题 + 设置入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:text="设置"
                android:textSize="13sp"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- 封面 -->
        <ImageView
            android:id="@+id/album_art"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:src="@drawable/ic_album"
            android:scaleType="centerInside"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp" />

        <!-- 歌名 / 空提示 -->
        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/player_waiting"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:gravity="center"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/text_empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/player_empty"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/accent"
            android:background="@color/accent_soft"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- 进度条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp">

            <TextView
                android:id="@+id/text_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/muted"
                android:minWidth="36dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/progress_track">

                <View
                    android:id="@+id/progress_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@color/accent" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/muted"
                android:minWidth="36dp"
                android:gravity="end" />
        </LinearLayout>

        <!-- 卡片: 元数据 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface_subtle"
            android:padding="16dp"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_device"
                    android:textSize="13sp"
                    android:textColor="@color/muted" />
                <TextView
                    android:id="@+id/text_device"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="13sp"
                    android:textColor="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_offset"
                    android:textSize="13sp"
                    android:textColor="@color/muted" />
                <TextView
                    android:id="@+id/text_offset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ms"
                    android:textSize="13sp"
                    android:textColor="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_drift"
                    android:textSize="13sp"
                    android:textColor="@color/muted" />
                <TextView
                    android:id="@+id/text_drift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ms"
                    android:textSize="13sp"
                    android:textColor="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_rtt"
                    android:textSize="13sp"
                    android:textColor="@color/muted" />
                <TextView
                    android:id="@+id/text_rtt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ms"
                    android:textSize="13sp"
                    android:textColor="@color/text" />
            </LinearLayout>
        </LinearLayout>

        <!-- 音量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_volume"
                android:textSize="13sp"
                android:textColor="@color/muted" />

            <SeekBar
                android:id="@+id/seek_volume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />
        </LinearLayout>

        <!-- 状态行 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp">

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_warn" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_connecting"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>