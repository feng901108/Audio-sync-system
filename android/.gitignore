# Android 客户端局部规则（不进 git）
# 主仓 Audio-sync-system/.gitignore 不动，这里只管 android/ 子树

# === Gradle / IDE 产物 ===
.gradle/
.idea/
*.iml
local.properties
build/
captures/
.externalNativeBuild/
.cxx/

# === Keystore（签名用，本地持有，绝不进仓）===
keystore/*.jks
keystore/*.keystore

# === Android Studio 配置 ===
*.hprof

# === OS 兜底 ===
.DS_Store
Thumbs.db

# === 临时文件 ===
*.log
*.bak
*.tmp